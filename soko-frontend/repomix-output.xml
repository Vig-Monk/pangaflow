/* =============================================================================
   src/styles/theme.css
   Single source of truth for the Soko Console design system.
   Change a value here and it updates everywhere — no component hardcodes a token.
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

:root {
  /* ---------- Brand palette (light) ---------- */
  --color-ink: #0F3D3E;
  --color-ink-hover: #0B2E2F;
  --color-gold: #E3A438;
  --color-gold-hover: #C98A22;
  --color-ledger-green: #2F8F6E;
  --color-market-clay: #C1502E;
  --color-info: #3B6EA5;

  /* ---------- Surfaces ---------- */
  --color-bg: #F3F6F4;
  --color-surface: #FFFFFF;
  --color-surface-raised: #FFFFFF;
  --color-border: #DCE4E0;

  /* ---------- Text ---------- */
  --color-text: #12211D;
  --color-text-muted: #52645D;
  --color-text-inverse: #F3F6F4;

  /* ---------- Focus / interaction ---------- */
  --color-focus-ring: #E3A438;

  /* ---------- Typography ---------- */
  --font-display: 'Fraunces', Georgia, serif;
  --font-body: 'IBM Plex Sans', -apple-system, Segoe UI, sans-serif;
  --font-mono: 'IBM Plex Mono', 'SF Mono', Consolas, monospace;

  --text-xs: 0.75rem;    /* 12px — timestamps, captions */
  --text-sm: 0.8125rem;  /* 13px — labels, table meta */
  --text-base: 1rem;     /* 16px — body */
  --text-lg: 1.125rem;   /* 18px — section headers */
  --text-xl: 1.25rem;    /* 20px — card titles */
  --text-2xl: 1.5rem;    /* 24px — page titles (display face) */
  --text-3xl: 2rem;      /* 32px — dashboard stat values */
  --text-4xl: 2.5rem;    /* 40px — rare, hero numbers only */

  --leading-tight: 1.2;
  --leading-normal: 1.5;
  --leading-relaxed: 1.7;

  /* ---------- Spacing (4px base grid) ---------- */
  --space-1: 0.25rem;  /* 4px */
  --space-2: 0.5rem;   /* 8px */
  --space-3: 0.75rem;  /* 12px */
  --space-4: 1rem;     /* 16px */
  --space-5: 1.25rem;  /* 20px */
  --space-6: 1.5rem;   /* 24px */
  --space-8: 2rem;     /* 32px */
  --space-10: 2.5rem;  /* 40px */
  --space-12: 3rem;    /* 48px */
  --space-16: 4rem;    /* 64px */

  /* ---------- Radius ---------- */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-full: 999px;

  /* ---------- Shadow (teal-tinted, never pure black) ---------- */
  --shadow-sm: 0 1px 2px rgba(15, 61, 62, 0.06), 0 1px 1px rgba(15, 61, 62, 0.04);
  --shadow-md: 0 4px 12px rgba(15, 61, 62, 0.08), 0 2px 4px rgba(15, 61, 62, 0.06);
  --shadow-lg: 0 12px 32px rgba(15, 61, 62, 0.12), 0 4px 8px rgba(15, 61, 62, 0.06);

  /* ---------- Motion ---------- */
  --duration-fast: 120ms;
  --duration-base: 200ms;
  --duration-slow: 320ms;
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ---------- Dark mode: same names, different values, nothing else changes ---------- */
[data-theme='dark'] {
  --color-ink: #57B8A0;
  --color-ink-hover: #6FCBB4;
  --color-gold: #F0B94D;
  --color-gold-hover: #F5CB74;
  --color-ledger-green: #4FBF95;
  --color-market-clay: #E17A54;
  --color-info: #6C9BCB;

  --color-bg: #0D1917;
  --color-surface: #142523;
  --color-surface-raised: #1B302D;
  --color-border: #263B37;

  --color-text: #EAF2EF;
  --color-text-muted: #9FB3AC;
  --color-text-inverse: #0D1917;

  --color-focus-ring: #F0B94D;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.24);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.32);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.4);
}

/* ---------- Respect the user's system preference on first load ---------- */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    color-scheme: dark;
  }
}

/* ---------- Base ---------- */
* { box-sizing: border-box; }

body {
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  -webkit-font-smoothing: antialiased;
  transition: background var(--duration-base) var(--ease-standard),
              color var(--duration-base) var(--ease-standard);
}

h1, h2, .page-title {
  font-family: var(--font-display);
  font-weight: 500;
  line-height: var(--leading-tight);
}

/* Every monetary figure and table number MUST carry this class */
.tabular-figure {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

/* ---------- Accessibility: visible focus, always ---------- */
:focus-visible {
  outline: 2px solid var(--color-focus-ring);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

/* ---------- Reduced motion respected ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ---------- The signature: stitched-margin accent bar ---------- */
.stitch {
  border-left: 3px solid var(--stitch-color, var(--color-border));
  padding-left: var(--space-4);
}
.stitch--in   { --stitch-color: var(--color-ledger-green); }
.stitch--out  { --stitch-color: var(--color-market-clay); }
.stitch--adjust { --stitch-color: var(--color-gold); }
</file>


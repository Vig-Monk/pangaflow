        <Pagination
          v-if="ledgerStore.entries.length > 0"
          :page="ledgerStore.page"
          :total-pages="Math.max(1, Math.ceil(ledgerStore.total / 20))"
          :on-change="(p) => ledgerStore.fetchLedger(id, { page: p })"
        />
      </section>
    </template>

    <!-- Delete Customer Confirmation Dialog -->

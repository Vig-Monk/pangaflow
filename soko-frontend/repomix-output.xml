      :open="showSmartSaleModal"
      :preselected-customer-id="props.id"
      @close="showSmartSaleModal = false"
      @success="refreshData"
    />

    <!-- Settle Debt Modal -->
    <SettleDebtModal
      :open="showSettleModal"
      :customer="customer"
      @close="showSettleModal = false"
      @success="refreshData"
    />
  </div>

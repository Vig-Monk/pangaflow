<script setup lang="ts">
// =============================================================================
// src/components/layout/NavItem.vue
// Active state: --color-ink bg at 10% opacity, --color-ink text, 3px gold
// left border. Reuses .stitch--adjust's visual treatment (gold stitch)
// but as a STATIC active indicator, not tied to a transaction type —
// applied directly here, not by attaching the .stitch class itself,
// since .stitch's semantic meaning (transaction type color-coding) is
// unrelated to what this component is indicating.
// =============================================================================

import { RouterLink, useRoute } from 'vue-router';

interface Props {
  to: { name: string };
  label: string;
  icon: string; // emoji, matching the existing project's icon approach
  //             (BottomNav.vue, Prompt 1.3) — no icon library dependency
  //             exists anywhere in this project; introducing one for
  //             four nav icons here would be a new dependency for a
  //             pattern the project has consistently avoided so far.
}

const props = defineProps<Props>();
const route = useRoute();

// Not just an exact name match — /customers/:id should also highlight
// the "Customers" nav item, the same "section-active" pattern the
// original Prompt 1.3 BottomNav.vue already used for customer-detail.
function isActive(): boolean {
  if (route.name === props.to.name) return true;
  if (props.to.name === 'customers' && route.name === 'customer-detail') return true;
  return false;
}
</script>

<template>
  <RouterLink :to="to" class="nav-item" :class="{ 'nav-item--active': isActive() }">
    <span class="nav-item__icon" aria-hidden="true">{{ icon }}</span>
    <span class="nav-item__label">{{ label }}</span>
  </RouterLink>
</template>


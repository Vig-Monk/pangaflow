          <LedgerRow
            v-for="tx in ledgerStore.entries"
            :key="tx.id"
            :customer-name="customer.name"
            :amount="formatCurrency(tx.amount)"
            :type="tx.type"
            :timestamp="formatTimestamp(tx.created_at)"
            :balance-after="formatCurrency(tx.balance_after)"
          />

// =============================================================================
// src/stores/auth.ts
// Auth store. Does NOT hold raw tokens in Pinia state — see note above.
// Reads auth status from tokenStorage.ts, the same source apiClient.ts's
// interceptor already reads from.
// =============================================================================

import { defineStore } from 'pinia';
import { apiPost } from '@/services/apiClient';
import { getAccessToken, setTokens, clearTokens } from '@/services/tokenStorage';

// ---------------------------------------------------------------------------
// Types — matching the REAL backend shapes (auth.service.ts's AuthResult).
// ---------------------------------------------------------------------------

export interface AuthUser {
  id: string;
  email: string;
  name: string;
  avatar_url: string | null;
}

export interface AuthOrg {
  id: string;
  name: string;
  slug: string;
  business_type: string;
  plan: string;
}

export interface TokenPair {
  accessToken: string;
  refreshToken: string;
}

export interface AuthResult {
  user: AuthUser;
  org: AuthOrg;
  tokens: TokenPair;
}

export interface RegisterBody {
  name: string;
  email: string;
  password: string;
  orgName: string;
  businessType: 'core' | 'shop' | 'salon' | 'stays' | 'market';
}

// ---------------------------------------------------------------------------
// Store
// ---------------------------------------------------------------------------

export const useAuthStore = defineStore('auth', {
  state: () => ({
    user: null as AuthUser | null,
    org: null as AuthOrg | null,
    isLoading: false,
    error: null as string | null,
  }),

  getters: {
    // Derived from tokenStorage, not from a duplicated token value held
    // in this store's own state — one source of truth.
    isAuthenticated: (): boolean => getAccessToken() !== null,
    businessType: (state): string | undefined => state.org?.business_type,
  },

  actions: {
    async register(body: RegisterBody): Promise<void> {
      this.isLoading = true;
      this.error = null;
      try {
        const result = await apiPost<AuthResult>('/auth/register', body);
        setTokens(result.tokens);
        this.user = result.user;
        this.org = result.org;
      } catch (err) {
        this.error = err instanceof Error ? err.message : 'Registration failed';
        throw err;
      } finally {
        this.isLoading = false;
      }
    },

    async login(email: string, password: string): Promise<void> {
      this.isLoading = true;
      this.error = null;
      try {
        const result = await apiPost<AuthResult>('/auth/login', { email, password });
        setTokens(result.tokens);
        this.user = result.user;
        this.org = result.org;
      } catch (err) {
        this.error = err instanceof Error ? err.message : 'Login failed';
        throw err;
      } finally {
        this.isLoading = false;
      }
    },

    async refresh(): Promise<void> {
      // Exposed for completeness per design.md's spec, but note:
      // apiClient.ts's response interceptor already performs this
      // silently and automatically on any 401. A component should
      // essentially never need to call this directly.
      const { getRefreshToken } = await import('@/services/tokenStorage');
      const refreshToken = getRefreshToken();
      if (!refreshToken) {
        throw new Error('No refresh token available');
      }
      const tokens = await apiPost<TokenPair>('/auth/refresh', { refreshToken });
      setTokens(tokens);
    },

    async logout(): Promise<void> {
      const { getRefreshToken } = await import('@/services/tokenStorage');
      const refreshToken = getRefreshToken();

      if (refreshToken) {
        try {
          await apiPost('/auth/logout', { refreshToken });
        } catch {
          // Best-effort server-side revocation — logout proceeds
          // locally regardless, same reasoning as the original Prompt
          // 1.3 auth.store.ts: an offline logout must still clear
          // local state.
        }
      }

      clearTokens();
      this.user = null;
      this.org = null;
    },
  },
});
</file>


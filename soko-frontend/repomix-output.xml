/* =============================================================================
   soko-frontend/src/styles/theme.css
   SOKO COMPACT RESPONSIVE DESIGN SYSTEM
   Palette: Vibrant Crimson (#D91E4E), Rich Emerald, True Charcoals & Soft Whites.
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

:root {
  /* =========================================================================
     1. MASTER BRAND ANCHOR
     ========================================================================= */
  --brand-primary: #D91E4E;
  --brand-primary-hover: color-mix(in srgb, var(--brand-primary) 85%, #000000);
  --brand-primary-light: color-mix(in srgb, var(--brand-primary) 10%, transparent);

  /* Primary Button Tokens */
  --btn-primary-bg: var(--brand-primary);
  --btn-primary-hover: var(--brand-primary-hover);
  --btn-primary-text: #FFFFFF;

  /* Deep charcoal ink for headings, secondary borders, dark badges */
  --color-ink: #18181B;
  --color-ink-hover: #27272A;

  /* Accent & Highlight */
  --color-gold: var(--brand-primary);
  --color-gold-hover: var(--brand-primary-hover);

  /* Functional Status Colors */
  --color-ledger-green: #1F7A4D;       /* Rich Botanical Emerald */
  --color-ledger-green-hover: #166534;
  --color-market-clay: #C2410C;        /* Warm Terracotta / Destructive */
  --color-info: #2563EB;               /* Vibrant Blue */

  /* =========================================================================
     2. LIGHT MODE SURFACES & ELEVATIONS
     ========================================================================= */
  --color-bg: #F8F9FA;
  --color-surface: #FFFFFF;
  --color-surface-raised: #FFFFFF;
  --color-surface-hover: #F1F3F5;
  --color-border: #EBECEF;

  --color-text: #18181B;
  --color-text-muted: #64748B;
  --color-text-inverse: #FFFFFF;

  --color-focus-ring: var(--brand-primary);

  /* =========================================================================
     3. SANS-SERIF TYPOGRAPHY & FLUID SCALES
     ========================================================================= */
  --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', 'SF Mono', Consolas, monospace;

  --text-xs: 0.6875rem;                                  /* 11px */
  --text-sm: 0.78125rem;                                 /* 12.5px */
  --text-base: 0.875rem;                                 /* 14px */
  --text-lg: clamp(0.9375rem, 1.2vw + 0.75rem, 1.0625rem); /* 15px - 17px */
  --text-xl: clamp(1.0625rem, 1.5vw + 0.75rem, 1.25rem);   /* 17px - 20px */
  --text-2xl: clamp(1.25rem, 2vw + 0.75rem, 1.45rem);      /* 20px - 23px */

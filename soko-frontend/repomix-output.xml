                  <XCircle :size="15" /> Out of Stock
                </span>
              </div>

              <!-- DYNAMIC VARIANT OPTION PILLS -->
              <div v-if="Object.keys(optionDimensions).length > 0" class="variant-selectors-stack">
                <div
                  v-for="(values, dimensionKey) in optionDimensions"
                  :key="dimensionKey"

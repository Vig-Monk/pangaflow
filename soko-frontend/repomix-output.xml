                      @click="selectOption(String(dimensionKey), val)"
                    >
                      {{ val }}
                    </button>
                  </div>
                </div>
              </div>

              <!-- Add to Cart Widget -->
              <div class="add-to-cart-widget" v-if="isCurrentlyInStock">

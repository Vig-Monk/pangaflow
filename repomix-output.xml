    const orderId = checkoutRes.data.data.orderId;
    console.log(`   ✓ Order placed. Order ID: ${orderId}`);

    // 6. Simulate Paid M-Pesa Webhook Callback
    console.log('6. Simulating verified M-Pesa webhook callback...');

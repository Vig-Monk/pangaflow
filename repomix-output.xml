// =============================================================================
// soko-frontend/src/stores/cart.ts
// Pinia store — Client-side shopping cart (Non-authoritative).
// Persists cart items locally across browser reloads.
// =============================================================================

import { defineStore } from "pinia";

export interface CartItem {
    product_id: string;
    name: string;
    image_url: string | null;
    price: number;
    quantity: number;
}

const CART_STORAGE_KEY = "soko_storefront_cart";

function loadInitialCart(): CartItem[] {
    if (typeof window === "undefined") return [];
    const stored = localStorage.getItem(CART_STORAGE_KEY);
    if (!stored) return [];
    try {
        return JSON.parse(stored);
    } catch {
        return [];
    }
}

function saveCartToStorage(items: CartItem[]): void {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(items));
}

export const useCartStore = defineStore("cart", {
    state: () => ({
        items: loadInitialCart() as CartItem[]
    }),

    getters: {
        isEmpty: (state): boolean => state.items.length === 0,

        totalItems: (state): number => {
            return state.items.reduce(
                (total, item) => total + item.quantity,
                0
            );
        },

        // Non-authoritative client estimate
        subtotal: (state): number => {
            return state.items.reduce(
                (total, item) => total + item.price * item.quantity,
                0
            );
        }
    },

    actions: {
        addItem(
            productId: string,
            name: string,
            imageUrl: string | null,
            price: number,
            quantity: number
        ): void {
            const existing = this.items.find(
                item => item.product_id === productId
            );

            if (existing) {
                // Enforce a client-side limit of 10 units per item
                existing.quantity = Math.min(10, existing.quantity + quantity);
            } else {
                this.items.push({
                    product_id: productId,
                    name,
                    image_url: imageUrl,
                    price,
                    quantity: Math.min(10, quantity)
                });
            }
            saveCartToStorage(this.items);
        },

        updateQuantity(productId: string, quantity: number): void {
            const item = this.items.find(item => item.product_id === productId);
            if (item) {
                item.quantity = Math.max(1, Math.min(10, quantity));
                saveCartToStorage(this.items);
            }
        },

        removeItem(productId: string): void {
            this.items = this.items.filter(
                item => item.product_id !== productId
            );
            saveCartToStorage(this.items);
        },

        clearCart(): void {
            this.items = [];
            localStorage.removeItem(CART_STORAGE_KEY);
        }
    }
});

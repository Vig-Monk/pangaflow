                      WHEN 'epub' THEN 3
                      ELSE 4
                    END
                  ) ASC
                )
                FROM product_formats pf
                WHERE pf.product_id = p.id
              ),
              '[]'::json
            ) AS formats
     FROM   products p
     LEFT JOIN categories c ON c.id = p.category_id
     LEFT JOIN inventory i  ON i.product_id = p.id
     WHERE  p.org_id     = $1
       AND  p.slug       = $2
       AND  p.status     = 'published'

              </div>

              <div class="item-card__body">
                <div class="item-details">
                  <h3 class="item-name">{{ item.name }}</h3>
                  <p class="item-unit-price tabular-figure">{{ formatCurrency(item.price) }}</p>
                </div>

                <div class="item-actions-row">
                  <div class="qty-select-wrap">
                    <select
                      :value="item.quantity"
                      class="qty-select"

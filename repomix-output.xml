<script setup lang="ts">
// =============================================================================
// soko-frontend/src/views/ProductsView.vue (FIXED PRODUCT ACTIONS)
// =============================================================================

import { onMounted, ref } from 'vue';
import { useRouter } from 'vue-router';
import { useProductsStore, type Product } from '@/stores/products';
import { useToast } from '@/composables/useToast';
import SearchBar from '@/components/ui/SearchBar.vue';
import DataTable, { type DataTableColumn } from '@/components/ui/DataTable.vue';
import Button from '@/components/ui/Button.vue';
import Pagination from '@/components/ui/Pagination.vue';
import ConfirmDialog from '@/components/ui/ConfirmDialog.vue';
import { Plus, Edit2, Trash2 } from 'lucide-vue-next';

const router = useRouter();
const productsStore = useProductsStore();
const { push: pushToast } = useToast();

const searchQuery = ref('');
const showConfirmDelete = ref(false);
const productToDelete = ref<Product | null>(null);
const isDeleting = ref(false);

onMounted(() => {
  productsStore.fetchList({ page: 1 });
});

function formatCurrency(value: string): string {
  const num = parseFloat(value);
  return `KES ${num.toLocaleString('en-KE', { maximumFractionDigits: 0 })}`;
}

const columns: DataTableColumn<Product>[] = [
  { key: 'name', label: 'Product' },
  { key: 'sku', label: 'SKU', render: (row) => row.sku ?? '—' },
  {
    key: 'price',
    label: 'Price',
    align: 'right',
    render: (row) => formatCurrency(row.price),
    cellClass: () => 'tabular-figure'
  },
  {
    key: 'status',
    label: 'Status',
    render: (row) => row.status.toUpperCase(),
  },
  {
    key: 'actions',
    label: 'Actions',
    align: 'right',
    render: () => '' 
  }
];

function handleSearch(query: string): void {
  searchQuery.value = query;
  productsStore.fetchList({ page: 1, q: query });
}

function handleAddProductsClick(): void {
  router.push({ name: 'products-add' });
}

function handleEdit(product: Product, event: Event): void {
  event.stopPropagation();
  router.push({ name: 'product-edit', params: { id: product.id } });
}

function confirmDelete(product: Product, event: Event): void {
  event.stopPropagation();
  productToDelete.value = product;
  showConfirmDelete.value = true;
}

async function executeDelete(): Promise<void> {
  if (!productToDelete.value) return;
  isDeleting.value = true;
  try {
    await productsStore.archiveProduct(productToDelete.value.id);
    pushToast({ message: `Archived ${productToDelete.value.name}`, variant: 'success' });
    showConfirmDelete.value = false;
    productToDelete.value = null;
    productsStore.fetchList({ page: productsStore.page, q: searchQuery.value });
  } catch {
    pushToast({ message: 'Failed to archive product', variant: 'error' });
  } finally {
    isDeleting.value = false;
  }
}
</script>

<template>
  <div class="products-page">
    <div class="page-header">
      <div>
        <h1 class="page-title">Products</h1>
        <p class="page-subtitle">Manage store catalog, pricing, and item publication.</p>
      </div>
      <div class="page-header__actions">
        <SearchBar placeholder="Search products…" @search="handleSearch" />
        <Button variant="primary" @click="handleAddProductsClick"><Plus :size="18" /> Add Products</Button>
      </div>
    </div>

    <div class="table-container-clean">
      <DataTable
        :columns="columns"
        :rows="productsStore.list"
        :loading="productsStore.isLoading"
        :row-key="(row) => row.id"
        empty-title="No products yet"
        empty-description="Create some products to publish on your online storefront."
      />

      <!-- Action Buttons Overlay Layer mapped over Table Rows -->
      <div class="custom-actions-wrapper">
        <div v-for="prod in productsStore.list" :key="prod.id" class="row-action-buttons">
          <button class="action-icon-btn" title="Edit product" @click="(e) => handleEdit(prod, e)">
            <Edit2 :size="15" />
          </button>
          <button class="action-icon-btn action-icon-btn--danger" title="Archive product" @click="(e) => confirmDelete(prod, e)">
            <Trash2 :size="15" />
          </button>
        </div>
      </div>
    </div>

    <Pagination
      v-if="productsStore.list.length > 0"
      :page="productsStore.page"
      :total-pages="Math.max(1, Math.ceil(productsStore.total / 20))"
      :on-change="(p) => productsStore.fetchList({ page: p, q: searchQuery })"
    />

    <ConfirmDialog
      :open="showConfirmDelete"
      title="Archive Product"
      :message="`Are you sure you want to archive '${productToDelete?.name}'? It will be hidden from your public storefront catalog.`"
      confirm-label="Archive Product"
      danger
      @confirm="executeDelete"
      @cancel="showConfirmDelete = false"
    />
  </div>

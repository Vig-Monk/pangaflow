import { onMounted, ref, computed } from 'vue';
import { useRoute } from 'vue-router';
import { apiGet } from '@/services/apiClient';
import Skeleton from '@/components/ui/Skeleton.vue';

interface PublicOrderDetails {
  orderId: string;
  customerName: string;
  total: number;
  status: string;

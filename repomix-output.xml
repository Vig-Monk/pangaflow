}

export async function decrementStockTransactional(
    client: PoolClient,
    productId: string,
    quantity: number
): Promise<boolean> {
    const result = await client.query(
        `UPDATE inventory
     SET    stock      = stock - $1
     WHERE  product_id = $2
       AND  stock      >= $1`,
        [quantity, productId]
    );
    return result.rowCount !== null && result.rowCount > 0;
}


router.post('/mpesa/stk', verifyToken, validateBody(StkPushBodySchema), stkPushHandler);

// POST /api/v1/payments/mpesa/callback — PUBLIC, no verifyToken
router.post('/mpesa/callback', callbackHandler);

export default router;

  next: NextFunction
): Promise<void> {
  try {
    const orgId = requireOrgId(req);
    const successArchived = await productsQueries.archiveProduct(orgId, req.params.id);
    if (!successArchived) {
      throw new AppError('Product not found', 404);
    }
    success(res, { archived: true });
  } catch (err) {
    next(err);
  }
}

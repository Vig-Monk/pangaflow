interface Props {
  page: number;
  totalPages: number;
  onChange: (page: number) => void;
}

const props = defineProps<Props>();

function goPrev(): void {
  if (props.page > 1) {
    props.onChange(props.page - 1);
  }
}

function goNext(): void {
  if (props.page < props.totalPages) {
    props.onChange(props.page + 1);
  }
}
</script>


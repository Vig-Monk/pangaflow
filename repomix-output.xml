            <Button variant="secondary" size="md" @click="emit('close')">
              Start Shopping
            </Button>
          </div>

          <!-- Cart Items List -->
          <template v-else>
            <div class="drawer-items-list">
              <div
                v-for="item in cartStore.items"
                :key="item.product_id"
                class="drawer-item"
              >
                <div class="item-thumb">
                  <img
                    v-if="item.image_url"

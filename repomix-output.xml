export async function fullDashboardHandler(
  req: Request,
  res: Response,
  next: NextFunction
): Promise<void> {
  try {
    const { orgId } = requireAuth(req);
    const result = await expensesService.fullDashboard(orgId);
    success(res, result);
  } catch (err) {
    next(err);

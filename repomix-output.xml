            >
              <Trash2 :size="15" /> Delete
            </button>
          </div>
        </div>

        <div class="balance-block">
          <p class="balance-label">Current Balance</p>
          <p
            class="balance-value tabular-figure"
            :class="hasDebt ? 'balance-value--owed' : 'balance-value--credit'"

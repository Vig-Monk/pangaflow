        `UPDATE products
         SET deleted_at = NOW(),
             status     = 'archived',
             slug       = slug || '-deleted-' || $3,
             updated_at = NOW()
         WHERE org_id = $1 AND id = $2`,
        [orgId, productId, timestamp]

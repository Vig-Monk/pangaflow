<file path="soko-frontend/src/styles/theme.css">
/* =============================================================================
   soko-frontend/src/styles/theme.css
   SOKO COMPACT RESPONSIVE DESIGN SYSTEM
   Palette: Vibrant Crimson (#D91E4E), Rich Emerald, True Charcoals & Soft Whites.
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

:root {
  /* =========================================================================
     1. MASTER BRAND ANCHOR
     ========================================================================= */
  --brand-primary: #D91E4E;
  --brand-primary-hover: color-mix(in srgb, var(--brand-primary) 85%, #000000);
  --brand-primary-light: color-mix(in srgb, var(--brand-primary) 10%, transparent);

  /* Primary Button Tokens */
  --btn-primary-bg: var(--brand-primary);
  --btn-primary-hover: var(--brand-primary-hover);
  --btn-primary-text: #FFFFFF;

  /* Deep charcoal ink for headings, secondary borders, dark badges */
  --color-ink: #18181B;
  --color-ink-hover: #27272A;

  /* Accent & Highlight */
  --color-gold: var(--brand-primary);
  --color-gold-hover: var(--brand-primary-hover);

  /* Functional Status Colors */
  --color-ledger-green: #1F7A4D;       /* Rich Botanical Emerald */
  --color-ledger-green-hover: #166534;
  --color-market-clay: #C2410C;        /* Warm Terracotta / Destructive */
  --color-info: #2563EB;               /* Vibrant Blue */

  /* =========================================================================
     2. LIGHT MODE SURFACES & ELEVATIONS
     ========================================================================= */
  --color-bg: #F8F9FA;
  --color-surface: #FFFFFF;
  --color-surface-raised: #FFFFFF;
  --color-surface-hover: #F1F3F5;
  --color-border: #EBECEF;

  --color-text: #18181B;
  --color-text-muted: #64748B;
  --color-text-inverse: #FFFFFF;

  --color-focus-ring: var(--brand-primary);

  /* =========================================================================
     3. SANS-SERIF TYPOGRAPHY & FLUID SCALES
     ========================================================================= */
  --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', 'SF Mono', Consolas, monospace;

  --text-xs: 0.6875rem;                                  /* 11px */
  --text-sm: 0.78125rem;                                 /* 12.5px */
  --text-base: 0.875rem;                                 /* 14px */
  --text-lg: clamp(0.9375rem, 1.2vw + 0.75rem, 1.0625rem); /* 15px - 17px */
  --text-xl: clamp(1.0625rem, 1.5vw + 0.75rem, 1.25rem);   /* 17px - 20px */
  --text-2xl: clamp(1.25rem, 2vw + 0.75rem, 1.45rem);      /* 20px - 23px */
  --text-3xl: clamp(1.45rem, 2.8vw + 0.75rem, 1.85rem);    /* 23px - 29.5px */
  --text-4xl: clamp(1.65rem, 4vw + 0.75rem, 2.25rem);      /* 26px - 36px */

  --leading-tight: 1.22;
  --leading-normal: 1.55;
  --leading-relaxed: 1.7;

  /* =========================================================================
     4. SPACING SCALE
     ========================================================================= */
  --space-1: 0.25rem;   /* 4px */
  --space-2: 0.5rem;    /* 8px */
  --space-3: 0.75rem;   /* 12px */
  --space-4: 1rem;      /* 16px */
  --space-5: 1.25rem;   /* 20px */
  --space-6: 1.5rem;    /* 24px */
  --space-8: 2rem;      /* 32px */
  --space-10: 2.5rem;   /* 40px */
  --space-12: 3rem;     /* 48px */
  --space-16: 4rem;     /* 64px */

  /* =========================================================================
     5. RADII & SHADOWS
     ========================================================================= */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-full: 9999px;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);
  --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.05), 0 2px 6px rgba(0, 0, 0, 0.02);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.07), 0 4px 10px rgba(0, 0, 0, 0.03);

  --duration-fast: 120ms;
  --duration-base: 200ms;
  --duration-slow: 320ms;
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
}

/* =============================================================================
   MOBILE VIEWPORT ADAPTATIONS (<= 640px)
   ========================================================================== */
@media (max-width: 640px) {
  :root {
    --space-5: 1rem;
    --space-6: 1.125rem;
    --space-8: 1.375rem;
    --space-10: 1.75rem;
    --space-12: 2rem;
    --space-16: 2.5rem;
    --radius-lg: 12px;
  }
}

/* =============================================================================
   DARK MODE ELEVATION & CONTRAST (True Charcoal & Luminous Accents)
   ========================================================================== */
[data-theme='dark'] {
  --brand-primary: #E83D69;
  --brand-primary-hover: color-mix(in srgb, var(--brand-primary) 85%, #FFFFFF);
  --brand-primary-light: color-mix(in srgb, var(--brand-primary) 18%, transparent);

  --btn-primary-bg: var(--brand-primary);
  --btn-primary-hover: var(--brand-primary-hover);
  --btn-primary-text: #FFFFFF;

  --color-bg: #0F0F12;
  --color-surface: #17171C;
  --color-surface-raised: #202027;
  --color-surface-hover: #282832;
  --color-border: #2C2C36;

  --color-ink: #F4F4F5;
  --color-ink-hover: #FFFFFF;

  --color-gold: var(--brand-primary);
  --color-gold-hover: var(--brand-primary-hover);

  --color-ledger-green: #34D399;
  --color-ledger-green-hover: #10B981;
  --color-market-clay: #FB7185;
  --color-info: #60A5FA;

  --color-text: #F4F4F5;
  --color-text-muted: #94A3B8;
  --color-text-inverse: #0F0F12;

  --color-focus-ring: var(--brand-primary);

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.35);
  --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.45);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.6);
}

/* =============================================================================
   GLOBAL RESET
   ========================================================================== */
* {
  box-sizing: border-box;
}

html, body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transition: background var(--duration-base) var(--ease-standard),
              color var(--duration-base) var(--ease-standard);
}

h1, h2, h3, .page-title {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: var(--leading-tight);
}

.tabular-figure {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

:focus-visible {
  outline: 2px solid var(--color-focus-ring);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

.stitch {
  border-left: 3px solid var(--stitch-color, var(--color-border));
  padding-left: var(--space-4);
}
.stitch--in     { --stitch-color: var(--color-ledger-green); }
.stitch--out    { --stitch-color: var(--color-market-clay); }
.stitch--adjust { --stitch-color: var(--brand-primary); }
